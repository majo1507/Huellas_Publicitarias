# ============================================================
# Configuración de entorno — Frontend ORVEX (Vite)
# ============================================================
VITE_API_URL=http://localhost:3000/api
VITE_USE_MOCK=false

# ============================================================
# Firebase Authentication — Frontend SDK (orvex-3c836)
# Obtén estos valores en Firebase Console > Configuración del proyecto > Tus apps > Web
# ============================================================
VITE_FIREBASE_API_KEY=tu_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=orvex-3c836.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orvex-3c836
VITE_FIREBASE_STORAGE_BUCKET=orvex-3c836.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id_aqui
VITE_FIREBASE_APP_ID=tu_firebase_app_id_aqui
