# ============================================================
# Configuración de entorno — Backend ORVEX (Huellas Publicidad)
# Copia este archivo como .env y ajusta los valores de conexión
# ============================================================

PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Conexión PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_empresarial
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Seguridad JWT (usa una cadena aleatoria segura de al menos 32 caracteres)
JWT_SECRET=reemplazar_por_secreto_jwt_seguro_orvex_2026
JWT_EXPIRES_IN=24h

# ============================================================
# Firebase Admin SDK — Backend Authentication (orvex-3c836)
# Opción A (Recomendada): Descarga la clave privada en Firebase Console >
# Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Guárdala como backend/config/firebase-service-account.json (protegida por .gitignore).
# ============================================================
FIREBASE_PROJECT_ID=orvex-3c836
FIREBASE_SERVICE_ACCOUNT_PATH=backend/config/firebase-service-account.json
# Opción B (Alternativa en variables):
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@orvex-3c836.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
